#!/usr/bin/env bash
# Offline stand-in for gh: answers from $STUB_DIR, records every call in gh.calls.
printf '%s\n' "$*" >> "$STUB_DIR/gh.calls"
[ "${STUB_GH_FAIL:-0}" = 1 ] && { echo "stub: network down" >&2; exit 1; }
args="$*"
case "$args" in
  *search/issues*)
    case "$args" in
      *"is:issue"*label:*) cat "$STUB_DIR/issues.json" 2>/dev/null || echo '{"incomplete_results":false,"items":[]}';;
      *"is:issue"*) cat "$STUB_DIR/open-issues.json" 2>/dev/null || echo '{"incomplete_results":false,"items":[]}';;
      *"is:open"*) cat "$STUB_DIR/open.json" 2>/dev/null || echo '{"incomplete_results":false,"items":[]}';;
      *) cat "$STUB_DIR/search.json";;
    esac;;
  *"api user"*) echo '{"login":"design-bot"}' | { if [[ "$args" == *"--jq"* ]]; then echo design-bot; else cat; fi; };;
  *"--jq .private"*) cat "$STUB_DIR/private.txt" 2>/dev/null || { echo "stub: no such repository" >&2; exit 1; };;
  *milestones*) cat "$STUB_DIR/milestones.json" 2>/dev/null || echo '[]';;
  *repos/*/issues/*)
    n="$(printf '%s' "$args" | sed -E 's#.*issues/([0-9]+).*#\1#')"
    cat "$STUB_DIR/issue-$n.state" 2>/dev/null || echo open;;
  *pulls/*/files*)
    n="$(printf '%s' "$args" | sed -E 's#.*pulls/([0-9]+)/files.*#\1#')"
    f="$STUB_DIR/files-$n.txt"; [ -f "$f" ] && cat "$f";;
  *repos/*/pulls/[0-9]*) # one pull request: "<head repo>\t<base repo>", as pr_same_repo's --jq asks
    n="$(printf '%s' "$args" | sed -E 's#.*pulls/([0-9]+).*#\1#')"
    f="$STUB_DIR/pull-$n.tsv"; [ -f "$f" ] || { echo "stub: no pull $n" >&2; exit 1; }; cat "$f";;
  *) echo "stub: unhandled gh $args" >&2; exit 1;;
esac
