#!/usr/bin/env bash
# pre-push — every product checkout of this agent uses this hook (scripts/checkout.sh
# sets core.hooksPath). It enforces what CLAUDE.md promises: a push goes only to a
# design-desk/ branch of the configured repository, only when the operator set
# prototype_remote, and never with a change under .github/ (a workflow runs with the
# repository's secrets). A local guard only: the operator's ruleset or token scope is the
# real control (docs/prototype.md → Push).
# git passes "<remote name> <url>" as arguments, "<local ref> <local sha> <remote ref>
# <remote sha>" per ref on stdin.
WORK="${WORK_DIR:-${HOME:-/home/agent}/work}"
CONFIG="$WORK/CONFIG.md"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$HOOK_DIR/../lib/config.sh" 2>/dev/null || { echo "design-desk: cannot read scripts/lib/config.sh — refusing to push" >&2; exit 1; }
remote_cfg="$(cfg prototype_remote)"
if [ -z "$remote_cfg" ] || [ "$remote_cfg" = none ]; then
  echo "design-desk: pushing is off (prototype_remote: none) — the prototype's record is the patch on its Desk card" >&2
  exit 1
fi
# The destination must be the configured repository on its host, whatever remote name it
# has here: https://[user@]host[:port]/owner/name[.git], ssh://[user@]host[:port]/owner/name,
# [user@]host:owner/name. The host is cut from the authority (before the first / of a URL,
# before the first : of the scp form) and only then stripped of its user and port, so
# https://evil.example/x@github.com/... reads as evil.example. An authority with any other
# character (?, #, \, a second @) or any other scheme is refused, never guessed.
lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }
case "$remote_cfg" in */*/*) want="$remote_cfg";; *) want="github.com/$remote_cfg";; esac
url="${2:-}"; u="$(lower "${url%/}")"; u="${u%.git}"
user='([a-z0-9._~%+-]+(:[a-z0-9._~%+-]*)?@)?'; host='[a-z0-9]([a-z0-9.-]*[a-z0-9])?'
case "$u" in
  https://*|ssh://*)
    u="${u#*://}"; auth="${u%%/*}"; path="${u#"$auth"}"
    if [[ "$auth" =~ ^$user($host)(:[0-9]+)?$ ]]; then u="${BASH_REMATCH[3]}$path"; else u=""; fi;;
  *://*) u="";;
  *:*)
    auth="${u%%:*}"; path="${u#*:}"
    if [[ "$auth" =~ ^$user($host)$ ]] && [ -n "$path" ]; then u="${BASH_REMATCH[3]}/$path"; else u=""; fi;;
  *) u="";;
esac
if [ -z "$u" ] || [ "$u" != "$(lower "$want")" ]; then
  echo "design-desk: refusing to push to $url — prototype_remote is $remote_cfg" >&2; exit 1
fi
zero=0000000000000000000000000000000000000000
while read -r _local lsha remote_ref rsha; do
  case "$remote_ref" in
    refs/heads/design-desk/*) ;;
    *) echo "design-desk: refusing to push to $remote_ref — only design-desk/ branches (CLAUDE.md → Hard invariants)" >&2; exit 1;;
  esac
  # design-desk/assets keeps every handoff a published comment links to: never deleted,
  # never rewound, only moved forward from the tip the remote has (docs/handoff.md step 5).
  if [ "$remote_ref" = refs/heads/design-desk/assets ]; then
    [ "$lsha" = "$zero" ] && { echo "design-desk: refusing to delete $remote_ref — old comments link to its commits" >&2; exit 1; }
    if [ -n "$rsha" ] && [ "$rsha" != "$zero" ]; then
      git cat-file -e "$rsha^{commit}" 2>/dev/null || { echo "design-desk: refusing to push $remote_ref — fetch it first: its tip $rsha is not here" >&2; exit 1; }
      git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null || { echo "design-desk: refusing to push $remote_ref — not a fast-forward of its tip; it is never rewound" >&2; exit 1; }
    fi
  fi
  [ "$lsha" = "$zero" ] && continue   # deleting the branch
  # Every commit this push brings that the remote does not have yet (merges by their own
  # changes): none may touch .github/. -z: git writes every path as it is, never quoted
  # (a quoted "\.github/..." line would not start with .github/), one per NUL.
  if ! paths="$(set -o pipefail; git log -z --format= --name-only --no-renames --cc "$lsha" --not --remotes 2>/dev/null | tr '\0' '\n')"; then
    echo "design-desk: refusing to push $remote_ref — cannot tell which files $lsha changes" >&2; exit 1
  fi
  if printf '%s\n' "$paths" | grep -q -e '^\.github/' -e '^"'; then
    echo "design-desk: refusing to push $remote_ref — it changes .github/ (workflows run with the repository's secrets; a prototype changes the look only)" >&2; exit 1
  fi
  # Handoff bundles live on design-desk/assets alone, and it holds nothing else
  # (docs/handoff.md step 5): a prototype that merges can never bring one into the product.
  # On assets, every commit of its whole history: a tip that brings product history (main
  # pushed onto it) or a commit the remote already has elsewhere is judged too, not skipped.
  if [ "$remote_ref" = refs/heads/design-desk/assets ]; then
    if ! all="$(set -o pipefail; git log -z --format= --name-only --no-renames --cc "$lsha" 2>/dev/null | tr '\0' '\n')"; then
      echo "design-desk: refusing to push $remote_ref — cannot tell which files $lsha holds" >&2; exit 1
    fi
    if printf '%s\n' "$all" | grep -v -e '^$' -e '^\.design-desk/handoff/R-[0-9][0-9]*/' | grep -q .; then
      echo "design-desk: refusing to push $remote_ref — it holds handoff bundles only (.design-desk/handoff/R-<n>/)" >&2; exit 1
    fi
  elif printf '%s\n' "$paths" | grep -q '^\.design-desk/handoff/'; then
    echo "design-desk: refusing to push $remote_ref — a handoff bundle goes on design-desk/assets only" >&2; exit 1
  fi
done
exit 0
